#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"

# Remove all generated CUDA source files in this codegen directory.
find ../codegen -maxdepth 1 -type f -name '*.cu' -delete


# Reset pybind module source to the empty default template.
cat > ../codegen/bindings.cpp <<'EOF'
#include "bindings.h"

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {

}
EOF

# Reset pybind bindings header to the empty default template.
cat > ../codegen/bindings.h <<'EOF'
#pragma once
#include <torch/extension.h>


EOF
